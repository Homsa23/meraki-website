# Meraki — Firebase Configuration Template
# Duplicate this file to .env.local, then run `npm run register:web-app`
# to fill in the meraki-92e3f web app values automatically.

NEXT_PUBLIC_FIREBASE_API_KEY="REPLACE_WITH_MERAKI_92E3F_WEB_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="meraki-92e3f.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="meraki-92e3f"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="meraki-92e3f.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="REPLACE_WITH_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="REPLACE_WITH_WEB_APP_ID"

# Server-only — service account used by `npm run seed:products`,
# `npm run deploy:rules`, and `npm run register:web-app`.
# Keep this file out of version control.
# FIREBASE_SERVICE_ACCOUNT_KEY="C:\\path\\to\\meraki-92e3f-service-account.json"
