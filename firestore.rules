rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Storefront catalog — world readable, writable only by the Admin SDK
    // (the seed script) or the Firebase Console.
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Per-client records — each authenticated user can only touch their own.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
